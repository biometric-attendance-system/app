<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" styleClass="main-container" stylesheets="@TableView.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.projekt.controller.AttendanceController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Button onAction="#goHome" styleClass="action-button" text="Home" />
        <Label styleClass="page-title" text="Attendance History" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="infoLabel" styleClass="info-label" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label styleClass="form-label" text="Select Date:" />
        <DatePicker fx:id="datePicker" prefWidth="150.0" styleClass="custom-date-picker" />
        <Separator orientation="VERTICAL" />
        <Label styleClass="form-label" text="Search:" />
        <TextField fx:id="filterField" prefWidth="250.0" promptText="Name, album number or status..." styleClass="form-field" />
    </HBox>

    <TableView fx:id="attendanceTable" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameCol" prefWidth="250.0" text="Student Name" />
            <TableColumn fx:id="albumCol" prefWidth="150.0" text="Album Number" />
            <TableColumn fx:id="statusCol" prefWidth="150.0" text="Status" />
            <TableColumn fx:id="timeCol" prefWidth="150.0" text="Time" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>