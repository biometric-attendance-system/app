<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="10" styleClass="main-container" stylesheets="@TableView.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.projekt.controller.StudentController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox alignment="CENTER_LEFT" spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button onAction="#goHome" styleClass="action-button" text="Home" />
            <Label fx:id="errorLabel" styleClass="error-label" />
        </HBox>
        <Separator />
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="form-label" text="Search:" />
            <TextField fx:id="filterField" promptText="Type name, surname or album number..." styleClass="form-field" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>

    <TableView fx:id="studentTable" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameCol" prefWidth="150" text="First Name" />
            <TableColumn fx:id="surNameCol" prefWidth="150" text="Last Name" />
            <TableColumn fx:id="albumNumberCol" prefWidth="150" text="Album Number" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Separator />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="form-label" text="Delete Student:" />
        <TextField fx:id="albumNumberField" promptText="Type album number..." styleClass="form-field" HBox.hgrow="ALWAYS" />
        <Button onAction="#deleteStudent" styleClass="action-button" text="Delete" />
    </HBox>

    <Label fx:id="deleteLabel" styleClass="info-label" />
</VBox>