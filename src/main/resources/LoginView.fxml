<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<HBox spacing ="30.0" alignment="center" styleClass="main-container" stylesheets="@CameraView.css" xmlns:fx="http://javafx.com/fxml" fx:controller="pl.projekt.controller.LoginController">
    
    <VBox spacing="10.0" alignment="center" styleClass="sidebar">
        <GridPane alignment="center" hgap="10" vgap="10">

            <Label text = "Log in" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="form-label"/>
            <TextField fx:id="name" promptText="Type login" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="form-field"/>
            <PasswordField fx:id="password" promptText="Type password" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="form-field"/>

        </GridPane>
    
        <Button text = "Login" onAction="#handleLogin" styleClass="action-button"/>

        <Label fx:id="errorLabel" alignment="center" styleClass="status-label"/>
    </VBox>

    <Separator orientation="VERTICAL" prefWidth="20"/>
    

    <ImageView fx:id="cameraView" fitWidth="640" fitHeight="480" preserveRatio="true" styleClass="camera-container"/>
</HBox>