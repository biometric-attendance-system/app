<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" alignment="center" xmlns:fx="http://javafx.com/fxml" fx:controller="pl.projekt.controller.LoginController" >
    <GridPane xmlns:fx="http://javafx.com/fxml" alignment="center" hgap="10" vgap="10">

        <Label text = "Log in" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <TextField fx:id="name" promptText="Type login" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <PasswordField fx:id="password" promptText="Type password" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    </GridPane>
    
    <Button text = "Zaloguj" onAction="#handleLogin" GridPane.columnIndex="2" GridPane.rowIndex="3"/>

    <Label fx:id="errorLabel" alignment="center"/>
</VBox>
