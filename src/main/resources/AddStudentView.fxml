<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.projekt.controller.AddStudentController" spacing="40">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="15">

        <Button text="Home" onAction="#goHome" prefWidth="120"/>

        <Label fx:id="errorLabel"/>

        <Label text="First name"/>
        <TextField fx:id="name" promptText="Enter first name"/>

        <Label text="Surname"/>
        <TextField fx:id="surname" promptText="Enter last name"/>

        <Label text="Album number"/>
        <TextField fx:id="albumNumber" promptText="Enter album number"/>

        <Button text="Save student"
                onAction="#saveStudent"/>

        <Label fx:id="fieldsErrorLabel"/>

    </VBox>

    <VBox spacing="15">

        <ImageView fx:id="cameraView" fitWidth="500" fitHeight="350" preserveRatio="true"/>

        <Button text="Start / Stop Recording" onAction="#startStopRecording"/>
        <Label fx:id="cameraErrorLabel"/>

    </VBox>

</HBox>