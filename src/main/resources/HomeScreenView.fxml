<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<HBox spacing="30.0" alignment="TOP_CENTER" styleClass="main-container" stylesheets="@CameraView.css" xmlns:fx="http://javafx.com/fxml" fx:controller="pl.projekt.controller.HomeController">
    
    <VBox spacing="15.0" alignment="TOP_CENTER" styleClass="sidebar">
        <Label text="MENU" styleClass="sidebar-title"/>
        <Button text="Add student" onAction="#addStudent" styleClass="nav-button"/>
        <Button text="Show statistics" onAction="#showStatistics" styleClass="nav-button"/>
        <Button text="Show students" onAction="#showStudents" styleClass="nav-button"/>
        <Button text="Show attendance" onAction="#showAttendance" styleClass="nav-button"/>
    </VBox>

    <VBox spacing="20.0" alignment="CENTER" styleClass="content-panel">
        <StackPane styleClass="camera-container">
            <ImageView fx:id="cameraView" fitWidth="640" fitHeight="480" preserveRatio="true"/>
        </StackPane>

        <HBox spacing="15.0" alignment="CENTER">
            <ComboBox fx:id="cameraSelector" promptText="Choose camera" styleClass="camera-combo"/>
            <Button text="Start/stop recording" onAction="#startStopRecording" styleClass="action-button"/>
        </HBox>

        <Label fx:id="errorLabel" alignment="center" styleClass="status-label"/>
    </VBox>
</HBox>