<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.projekt.controller.StatisticsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <Button mnemonicParsing="false" onAction="#goHome" text="Home" />
                <Label text="Statistics">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Search Student:" />
                <TextField fx:id="filterField" prefWidth="250.0" promptText="Enter name or album number..." />
            </children>
        </HBox>

        <TableView fx:id="statsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="albumCol" prefWidth="120.0" text="Album Number" />
                <TableColumn fx:id="nameCol" prefWidth="200.0" text="Name" />
                <TableColumn fx:id="presentCol" prefWidth="100.0" text="Present" />
                <TableColumn fx:id="allCol" prefWidth="100.0" text="Total Classes" />
                <TableColumn fx:id="percentCol" prefWidth="120.0" text="Attendance %" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <Label fx:id="infoLabel" text="Status" textFill="#555555">
            <font>
                <Font name="System Italic" size="12.0" />
            </font>
        </Label>
        
    </children>
</VBox>